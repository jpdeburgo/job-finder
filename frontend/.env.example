# Copy to .env.local. Nothing here is required: with no variables set the
# dashboard reads the search script's .env (backend/.env, or the nearest .env
# in a parent directory such as the repository root) and then falls back to
# ../backend/local_firestore.json, exactly like the script does.
#
# Every variable below has the same meaning as in backend/.env.example.

# IG_STATE_BACKEND=auto                        # auto (default) | firestore | local
# GOOGLE_APPLICATION_CREDENTIALS=../backend/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": ...}  # inline JSON instead of a file path
# FIREBASE_PROJECT_ID=your-project-id          # inferred from the service account
# FIRESTORE_DATABASE=(default)
# FIRESTORE_JOBS_COLLECTION=jobs
# FIRESTORE_RUNS_COLLECTION=runs
# FIRESTORE_SETTINGS_COLLECTION=settings       # where your skill list from the dashboard is saved
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080       # use the Firebase emulator, no credentials

# Where the local stand-in lives (default: ../backend/local_firestore.json).
# IG_LOCAL_DB_PATH=../backend/local_firestore.json
# Where the script lives, if you move it (default: ../backend).
# IG_BACKEND_DIR=../backend

# The search API (backend/api.py) behind the "Run search" button. Like the
# variables above, these are also read from the script's .env.
# IG_API_URL=http://127.0.0.1:8000             # default
# IG_API_TOKEN=...                             # must match the API's IG_API_TOKEN
