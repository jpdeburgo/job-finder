# Gmail API OAuth files and digest recipient.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
IG_EMAIL_TO=your-email@gmail.com
# Without these, the search still runs and saves jobs; it just skips the email.
# IG_REQUIRE_EMAIL=true                       # make missing email setup an error

# Job state. With nothing below set, the script uses local_firestore.json (a
# local stand-in that mirrors Firestore and prints every call it would make).
# To use real Firebase Firestore, point this at the service-account JSON from
# the Firebase console (Project settings > Service accounts > Generate new
# private key):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# Optional Firestore settings.
# IG_STATE_BACKEND=auto                        # auto (default) | firestore | local
# FIREBASE_PROJECT_ID=your-project-id          # inferred from the service account
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": ...}  # inline JSON instead of a file path
# FIRESTORE_DATABASE=(default)
# FIRESTORE_JOBS_COLLECTION=jobs
# FIRESTORE_RUNS_COLLECTION=runs
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080       # use the Firebase emulator, no credentials
# IG_LOCAL_DB_PATH=local_firestore.json        # where the local stand-in lives (the
#                                              # frontend/ dashboard reads the same variable)
